{%- comment -%}
  HeavenCraft -- send this store to theheavencraft.in.

  GENERATED FILE. Do not hand-edit.
  Regenerate with: npm run shopify:redirect-snippet

  Paste the whole of this file immediately after the opening <head> tag in
  layout/theme.liquid. Checkout and the order status page do not render this
  layout, so a checkout in progress is never affected by it.
{%- endcomment -%}

{%- liquid
  assign site = 'https://theheavencraft.in'
  assign target = site
-%}

{%- if request.page_type == 'product' -%}
  {%- case product.handle -%}
      {%- when 'cable-management-tray' -%}{%- assign target = site | append: '/accessories/cable-management-tray/' -%}
      {%- when 'cup-holder' -%}{%- assign target = site | append: '/accessories/cup-holder/' -%}
      {%- when 'desk-shelf-tray' -%}{%- assign target = site | append: '/accessories/desk-shelf-tray/' -%}
      {%- when 'desk-side-organiser' -%}{%- assign target = site | append: '/accessories/desk-side-organiser/' -%}
      {%- when 'footrest' -%}{%- assign target = site | append: '/accessories/footrest/' -%}
      {%- when 'keyboard-tray' -%}{%- assign target = site | append: '/accessories/keyboard-tray/' -%}
      {%- when 'peg-board' -%}{%- assign target = site | append: '/accessories/peg-board/' -%}
      {%- when 'neuro-mesh-chair' -%}{%- assign target = site | append: '/chairs/neuro-mesh-chair/' -%}
      {%- when 'xyron-mesh-chair' -%}{%- assign target = site | append: '/chairs/xyron-mesh-chair/' -%}
      {%- when 'zynx-mesh-chair' -%}{%- assign target = site | append: '/chairs/zynx-mesh-chair/' -%}
      {%- when 'casca-performance-mesh-chair' -%}{%- assign target = site | append: '/chairs/casca-performance-mesh-chair/' -%}
