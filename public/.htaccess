</IfModule>

# ---------------------------------------------------------------------------
# URLs withdrawn by the September 2026 range change
# ---------------------------------------------------------------------------
# Products that were dropped, ranges that emptied, and products that survived
# under a new name -- a rename moves the URL, because the slug comes from the
# name. All of these were served with a 200 by this site and are in the index.
<IfModule mod_rewrite.c>
  # The leather line was withdrawn entirely; there is no equivalent chair.
  RewriteRule ^product/chair-leather-002/?$ /chairs/ [R=301,L]
  # The leather line was withdrawn entirely; there is no equivalent chair.
  RewriteRule ^product/chair-leather-003/?$ /chairs/ [R=301,L]
  # The leather line was withdrawn entirely; there is no equivalent chair.
  RewriteRule ^product/chair-leather-005/?$ /chairs/ [R=301,L]
  # The fabric range became the performance mesh range -- Casca moved across under the same id.
  RewriteRule ^product/chair-fabric-001/?$ /chairs/performance-mesh-chair/ [R=301,L]
  # The fabric range became the performance mesh range -- Casca moved across under the same id.
  RewriteRule ^product/chair-fabric-005/?$ /chairs/performance-mesh-chair/ [R=301,L]
  # Replaced within the same range by the Flex Apex.
  RewriteRule ^product/table-bed-003/?$ /tables/bed-table/ [R=301,L]
  # The Primex variant was dropped; the standard Modura is the same table.
  RewriteRule ^product/table-height-adjustable-003/?$ /tables/modura-height-adjustable-table/ [R=301,L]
  # The Primex variant was dropped; the standard Quantum is the same desk.
  RewriteRule ^product/table-gaming-desk-002/?$ /tables/quantum-gaming-desk/ [R=301,L]
  # Storage boxes were withdrawn; nothing in the range replaces them.
  RewriteRule ^product/accessories-storage-box-002/?$ /accessories/ [R=301,L]
  # Storage boxes were withdrawn; nothing in the range replaces them.
  RewriteRule ^product/accessories-storage-box-004/?$ /accessories/ [R=301,L]
  # Basic and Plus merged into one footrest sold in three finishes, so the tiers are now colourways of a single product.
  RewriteRule ^product/accessories-footrest-002/?$ /accessories/footrest/ [R=301,L]
  # CPU stands were withdrawn; nothing in the range replaces them.
  RewriteRule ^product/accessories-Cpu-Stand-002/?$ /accessories/ [R=301,L]
  # CPU stands were withdrawn; nothing in the range replaces them.
  RewriteRule ^product/accessories-Cpu-Stand-003/?$ /accessories/ [R=301,L]
  # The desk shelf tray is what now lifts a monitor off the desk, so it is the nearest thing to what this visitor came for.
  RewriteRule ^product/accessories-monitor-stand-001/?$ /accessories/desk-shelf-tray/ [R=301,L]
  # The desk shelf tray is what now lifts a monitor off the desk, so it is the nearest thing to what this visitor came for.
  RewriteRule ^product/accessories-monitor-stand-004/?$ /accessories/desk-shelf-tray/ [R=301,L]
  # Desk hooks were withdrawn; the peg-board ships with hooks but is not a substitute for one.
  RewriteRule ^product/accessories-desk-hook-001/?$ /accessories/ [R=301,L]
  # Desk hooks were withdrawn; the peg-board ships with hooks but is not a substitute for one.
  RewriteRule ^product/accessories-desk-hook-002/?$ /accessories/ [R=301,L]
  RewriteRule ^chairs/rider-leather-chair/?$ /chairs/ [R=301,L]
  RewriteRule ^chairs/nexor-leather-chair/?$ /chairs/ [R=301,L]
  RewriteRule ^chairs/valerio-leather-chair/?$ /chairs/ [R=301,L]
  RewriteRule ^chairs/fabio-fabric-chair/?$ /chairs/performance-mesh-chair/ [R=301,L]
  RewriteRule ^chairs/niyo-fabric-chair/?$ /chairs/performance-mesh-chair/ [R=301,L]
  RewriteRule ^tables/flexon-bed-table/?$ /tables/bed-table/ [R=301,L]
  RewriteRule ^tables/modura-primex-height-adjustable-table/?$ /tables/modura-height-adjustable-table/ [R=301,L]
  RewriteRule ^tables/quantum-primex-gaming-desk/?$ /tables/quantum-gaming-desk/ [R=301,L]
  RewriteRule ^accessories/storage-box-plus/?$ /accessories/ [R=301,L]
  RewriteRule ^accessories/storage-box-pro-max/?$ /accessories/ [R=301,L]
  RewriteRule ^accessories/footrest-plus/?$ /accessories/footrest/ [R=301,L]
  RewriteRule ^accessories/cpu-stand-plus/?$ /accessories/ [R=301,L]
  RewriteRule ^accessories/cpu-stand-pro/?$ /accessories/ [R=301,L]
  RewriteRule ^accessories/monitor-stand-basic/?$ /accessories/desk-shelf-tray/ [R=301,L]
  RewriteRule ^accessories/monitor-stand-pro-max/?$ /accessories/desk-shelf-tray/ [R=301,L]
  RewriteRule ^accessories/desk-hook-basic/?$ /accessories/ [R=301,L]
  RewriteRule ^accessories/desk-hook-plus/?$ /accessories/ [R=301,L]
  RewriteRule ^chairs/casca-fabric-chair/?$ /chairs/casca-performance-mesh-chair/ [R=301,L]
  RewriteRule ^tables/exquisite-primex-folding-table/?$ /tables/exquisite-folding-table/ [R=301,L]
  RewriteRule ^tables/modulus-primex-height-adjustable-table/?$ /tables/modulus-height-adjustable-table/ [R=301,L]
  RewriteRule ^tables/zenvy-primex-study-table/?$ /tables/zenvy-study-table/ [R=301,L]
  RewriteRule ^accessories/footrest-basic/?$ /accessories/footrest/ [R=301,L]
  RewriteRule ^accessories/cable-tray-basic/?$ /accessories/cable-management-tray/ [R=301,L]
  RewriteRule ^accessories/cup-holder-basic/?$ /accessories/cup-holder/ [R=301,L]
  # No leather chairs remain.
  RewriteRule ^chairs/leather-chair/?$ /chairs/ [R=301,L]
  # The range was renamed and re-specified rather than dropped.
  RewriteRule ^chairs/fabric-chair/?$ /chairs/performance-mesh-chair/ [R=301,L]
  RewriteRule ^accessories/storage-box/?$ /accessories/ [R=301,L]
  RewriteRule ^accessories/cpu-stand/?$ /accessories/ [R=301,L]
  # Nearest surviving product, as above.
  RewriteRule ^accessories/monitor-stand/?$ /accessories/desk-shelf-tray/ [R=301,L]
  RewriteRule ^accessories/desk-hook/?$ /accessories/ [R=301,L]
</IfModule>

# ---------------------------------------------------------------------------
# Branded 404
# ---------------------------------------------------------------------------
# Must stay last: mod_rewrite stops at the first matching rule with [L], so
# every redirect above gets its chance before anything is treated as missing.
#
# This is an internal rewrite, not a redirect, so the browser keeps the dead
# URL in the address bar and the PHP shim sets the 404 itself -- which is the
# part this host does not intercept. Answering a missing page with a 200 would
# be worse than the grey default: Google calls that a soft 404 and can start
# distrusting URLs that do exist.
#
# The two conditions are what keep it from doing harm. A path that resolves to
# a real file or a real directory is left alone, so /chairs/ still serves
# its index, /enquiry.php still runs, and a hashed asset is still an asset.
# They also terminate the rewrite: the substitution is itself a real file, so
# the second pass matches nothing and the rule cannot loop.
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /404.php [L]
</IfModule>

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
</IfModule>

# ---------------------------------------------------------------------------
# Caching
# ---------------------------------------------------------------------------
# Hashed build assets are immutable and cached for a year. Everything else is
# revalidated, because a deploy changes it in place under the same URL.
#
# The default is deliberately "revalidate", not "a month". It used to be the
# other way round -- long-lived by default, with exceptions listed -- and that
# silently caught Next's client-navigation payloads. The App Router fetches
# those as .txt beside each page, they hold the rendered page, and they change
# on every build; Next appends ?_rsc=<hash> to them, but that hash is derived
# from the route pattern rather than the build, so it is identical across
# builds and busts nothing. The result was a stable URL, changing content, and
# a 30-day cache: a returning visitor navigating between pages was served a
# month-old rendering, and once a deploy moved the chunk graph the payload
# referenced files that had been deleted, so the page failed to hydrate and
# only a reload fixed it. An opt-in list cannot have that failure mode -- a
# file type nobody thought about gets revalidated instead of frozen.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Documents: same URL, new bytes on every deploy. This must cover the
  # .txt navigation payloads as well as the pages themselves -- they are the
  # same content reached a different way, and caching one but not the other is
  # what lets a visitor see two different versions of the site at once.
  <FilesMatch "\.(html|txt|xml|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "^(favicon\.ico|site\.webmanifest)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # Fingerprinted by the build, so the URL changes whenever the bytes do.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # ---- Security headers -------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
</IfModule>

# ---------------------------------------------------------------------------
# MIME types
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

# ---------------------------------------------------------------------------
# Character set
# ---------------------------------------------------------------------------
# The host serves "Content-Type: text/html" with no charset. Browsers cope,
# because <meta charset> sits in the first 1024 bytes and HTML5 says to honour
# it. Link scrapers are less reliable, and the copy is full of characters that
# break loudly when guessed wrong: the em dashes in every og:image:alt, the
# ellipsis that ends most og:description values, and the rupee sign in the
# prices. A WhatsApp preview reading those as Latin-1 renders "â¦" and "â¹".
# Declaring it in the header removes the guess. Scoped to the text types so
# it cannot be appended to an image or font response.
<IfModule mod_mime.c>
  AddCharset utf-8 .html .css .js .json .xml .svg .webmanifest .txt
</IfModule>
AddDefaultCharset utf-8
