# Shopify Admin API credentials.
#
# Copy this file to `.env` (which is gitignored) and fill in the two values.
# NEVER commit `.env`, paste the token into chat, or pass it on a command line.
#
# To create the token:
#   Shopify admin -> Settings -> Apps and sales channels -> Develop apps
#   -> Create an app -> Configuration -> Admin API integration
#   -> tick read_products and write_products, and nothing else
#   -> Save -> API credentials -> Install app -> reveal the Admin API access token
#
# The token is shown exactly once. If you lose it, uninstall and reinstall the app.
# It grants whatever scopes you ticked, so granting only the two above keeps the
# blast radius of a leak down to the product catalog.

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Defaults to a version pinned in scripts/shopify/client.ts.
# `npm run shopify:preflight` tells you if that default has aged out.
# SHOPIFY_API_VERSION=2025-01
