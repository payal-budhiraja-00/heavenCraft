# Shopify Admin API credentials.
#
# Copy this file to `.env` (which is gitignored) and fill in the blanks.
# NEVER commit `.env` or paste the Secret into chat -- the Secret can mint
# access tokens for your store, so it is as sensitive as a password.
#
# Where to find them:
#   https://dev.shopify.com/dashboard -> your app -> App settings -> Credentials
#
# Apps created in the Dev Dashboard (Shopify changed this on 1 January 2026)
# have NO long-lived shpat_ token. These scripts exchange the two values below
# for a token that expires after 24 hours, which is why nothing is stored.
#
# Three things must be true before this works:
#   1. the app has a RELEASED version granting read_products + write_products
#   2. the app is INSTALLED on the store
#   3. the app and the store are in the SAME Shopify organization

SHOPIFY_STORE_DOMAIN=theheavencraft.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional. Defaults to the version pinned in scripts/shopify/client.ts.
# `npm run shopify:preflight` reports if that default has aged out.
# SHOPIFY_API_VERSION=2025-01

# Legacy custom apps created before January 2026 use this instead of the pair
# above. Leave it commented out unless you have one.
# SHOPIFY_ADMIN_TOKEN=shpat_...


# ---------------------------------------------------------------------------
# Site build flags
# ---------------------------------------------------------------------------
#
# Whether the cart and checkout code is compiled into the bundle at all. CI
# and the deploy workflow both set this to true.
#
# It does NOT make the cart visible. This is a static export, so the HTML is
# built once and served identically to everyone, and there is no request-time
# hook to branch on. Visibility is decided in the browser by the preview gate:
# open any page with `?cart=on` to switch the basket on for that browser, and
# `?cart=off` to switch it back off. Until then every visitor sees the enquiry
# flow, which is what keeps live traffic out of a checkout that has no payment
# provider behind it yet.
NEXT_PUBLIC_COMMERCE_ENABLED=true

# Reviews are seeded demo content. `REVIEWS_ARE_REAL` additionally allows the
# "Verified purchase" badge and aggregateRating, and must stay false until
# there are real orders behind them -- a fabricated rating in structured data
# is a search-policy breach, not an exaggeration.
NEXT_PUBLIC_REVIEWS_ENABLED=false
NEXT_PUBLIC_REVIEWS_ARE_REAL=false